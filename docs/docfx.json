{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "Addins/**/*.csproj",
            "Addins.Fluent/**/*.csproj",
            "Extensions/**/*.csproj",
            "Interop/**/*.csproj"
          ],
          "src": ".."
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "allowCompilationErrors": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/gitbook"
    ],
    "globalMetadata": {
      "_appName": "Hymma.Solidworks",
      "_appTitle": "Hymma.Solidworks Documentation",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.ico",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/HYMMA/Hymma.Solidworks",
        "branch": "main",
        "apiSpecFolder": "docs/api"
      },
      "_appFooter": "<span>Built by <a href=\"https://hymma.net\" target=\"_blank\">HYMMA</a> \u2022 Powered by <a href=\"https://dotnet.github.io/docfx\">DocFX</a></span>"
    },
    "fileMetadata": {},
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}